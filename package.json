{
  "name": "XANCLD",
  "version": "1.0.0",
  "description": "XANCLD — Stream anime on Cloudflare Workers Free tier (Hono + Vite + React)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "anime",
    "streaming",
    "cloudflare-workers",
    "hono",
    "vite",
    "react",
    "tailwindcss",
    "anilist",
    "allanime",
    "free-tier"
  ],
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 3003",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir=dist-worker",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=18"
  }
}
