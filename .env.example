# XANCLD environment configuration.
#
# The app runs entirely on Cloudflare Workers Free tier with NO SECRETS.
# All user data (theme, autoplay, volume, history, library…) lives in the
# browser's localStorage — no server-side env vars are required.
#
# Everything below is OPTIONAL. Defaults match the current live providers,
# so an empty .env behaves identically to no .env.

# ─── Client (baked at build time, read via import.meta.env) ──────────
# Upstream provider domains — override if a provider rotates domains.
# VITE_ALLANIME_API=https://api.allanime.day/api
# VITE_ALLANIME_BASE=https://allanime.day
# VITE_KOTO_BASE=https://megaplay.buzz

# ─── Worker (wrangler.toml [vars] / Cloudflare dashboard) ────────────
# Provider domains for the server-side crypto resolver and Zen proxy:
#   ALLANIME_API, MKISSA_ORIGIN, ZEN_HOST   (see src/worker/runtimeConfig.ts)
#
# Relay protection — restrict which sites may call your /api/proxy* and
# /api/stream* routes from a browser. Comma-separated origin list; unset =
# open to all origins (previous behavior). Requests without an Origin
# header (same-origin, curl) always pass.
# ALLOWED_ORIGINS=https://yourdomain.com,https://xan.example.com
